01","control_ref":"WEB-12","legacy_control_ref":"WEB-13","nist_800_53a":null,"origins":"SCF Created","ppt":"Process","recommended_parameters":null,"source_row":6442,"statement":"Indicators of Compromise (IoC) include unauthorized alterations, additions, deletions or changes on websites that store, process and/or transmit sensitive / regulated data."},{"ao_id":"WEB-12_A02","control_ref":"WEB-12","legacy_control_ref":"WEB-13","nist_800_53a":null,"origins":"SCF Created","ppt":"Technology","recommended_parameters":null,"source_row":6443,"statement":"a capability exists to monitor for web-based IoC triggers."},{"ao_id":"WEB-13_A01","control_ref":"WEB-13","legacy_control_ref":"WEB-14","nist_800_53a":null,"origins":"SCF Created","ppt":"Process","recommended_parameters":null,"source_row":6444,"statement":"the scope of publicly accessible systems is defined."},{"ao_id":"WEB-13_A02","control_ref":"WEB-13","legacy_control_ref":"WEB-14","nist_800_53a":null,"origins":"SCF Created","ppt":"Process","recommended_parameters":null,"source_row":6445,"statement":"publicly accessible systems containing sensitive / regulated data are identified."},{"ao_id":"WEB-13_A03","control_ref":"WEB-13","legacy_control_ref":"WEB-14","nist_800_53a":null,"origins":"SCF Created","ppt":"Process","recommended_parameters":"at least annually","source_row":6446,"statement":"a capability exists to routinely review the content on publicly accessible systems for sensitive / regulated data and remove such information, if discovered."},{"ao_id":"WEB-13_A04","control_ref":"WEB-13","legacy_control_ref":"WEB-14","nist_800_53a":null,"origins":"SCF Created","ppt":"Process","recommended_parameters":"no more than 24 hours after discovery","source_row":6447,"statement":"a capability exists to expeditiously remove sensitive / regulated data from publicly accessible systems, if discovered."}],"schema_version":1,"source_sha256":"5a89bf2d3c106a9a87d4b6e3d62dd3e147d0e960d4c07473045a10aa8a7df697","source_sheet":"Assessment Ob